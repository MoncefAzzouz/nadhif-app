# Backend environment — copy to ".env" and fill in real values (never commit .env).

# PostgreSQL connection. On the VPS, point at the local Postgres + DB user.
DATABASE_URL="postgresql://nadif:STRONG_DB_PW@localhost:5432/nadif_db"

# JWT signing secret. Generate a fresh one: openssl rand -hex 32
JWT_SECRET="change_me_to_a_long_random_string"

# Port the API listens on.
PORT=5001

# Path to the Firebase Admin service-account JSON (uploaded out-of-band, git-ignored).
FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/firebase-admin.json"

# Comma-separated browser origins allowed to call the API (the admin website).
# Add the VPS admin URL here.
CORS_ORIGINS="http://5.196.209.133:3000,http://localhost:3000"
