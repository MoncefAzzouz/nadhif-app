generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
  // url moved to prisma.config.ts
}

enum Role {
  ADMIN
  CUSTOMER
  CLEANER
}

enum OrderStatus {
  PENDING
  CALLED_NOT_PAID
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductOrigin {
  NONE
  LOCAL
  IMPORTED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String    @unique
  passwordHash  String
  fullName      String
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())

  orders        Order[]
  deviceTokens  DeviceToken[]
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   // "android" | "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cleaner {
  id            String    @id @default(uuid())
  fullName      String
  phone         String    @unique
  bio           String?
  isActive      Boolean   @default(true)
  rating        Float     @default(0)
  skills        String[]  @default([])
  createdAt     DateTime  @default(now())
  
  orders        Order[]
}

model Service {
  id                    String    @id @default(uuid())
  name                  String
  nameAr                String    @default("")
  nameFr                String    @default("")
  description           String
  descriptionAr         String    @default("")
  descriptionFr         String    @default("")
  picture               String
  extraWorkerPrice      Float
  rapidExtraWorkerPrice Float     @default(0)
  durationHours         Int
  
  materialPrice         Float
  materialsMandatory    Boolean
  
  localProductPrice     Float
  importedProductPrice  Float
  productsMandatory     Boolean
  
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  
  houseConfigs          HouseConfig[]
  orders                Order[]
  skills                Skill[]
}

model HouseConfig {
  id            String    @id @default(uuid())
  serviceId     String
  type          String    // e.g., f2, f3, f4
  typeAr        String    @default("")
  typeFr        String    @default("")
  workers       Int
  basePrice     Float
  rapidBasePrice Float   @default(0)
  durationHours Int       @default(3)

  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orders        Order[]
}

model Category {
  id                    String              @id @default(uuid())
  name                  String
  nameAr                String              @default("")
  nameFr                String              @default("")
  description           String
  descriptionAr         String              @default("")
  descriptionFr         String              @default("")
  picture               String
  
  materialPrice         Float               @default(0)
  materialsMandatory    Boolean             @default(false)
  
  localProductPrice     Float               @default(0)
  importedProductPrice  Float               @default(0)
  productsMandatory     Boolean             @default(false)
  
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  
  categoryServices      CategoryService[]
  orders                Order[]
  skills                Skill[]
}

model CategoryService {
  id            String    @id @default(uuid())
  categoryId    String
  name          String
  nameAr        String    @default("")
  nameFr        String    @default("")
  workers       Int
  basePrice     Float
  rapidBasePrice Float   @default(0)
  durationHours Int       @default(3)

  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orders        Order[]
}

model Promo {
  id                String    @id @default(uuid())
  code              String    @unique
  discountPercent   Float
  validFrom         DateTime
  validUntil        DateTime
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  
  orders            Order[]
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  cleanerId         String?
  serviceId         String?
  houseConfigId     String?
  categoryId        String?
  categoryServiceId String?
  promoId           String?
  
  extraWorkers      Int         @default(0)
  useMaterials      Boolean     @default(false)
  productOrigin     ProductOrigin @default(NONE)

  status            OrderStatus @default(PENDING)
  totalPrice        Float
  scheduledDate     DateTime
  address           String
  latitude          Float?
  longitude         Float?
  
  isRapid           Boolean     @default(false)
  sizeM2            Float?
  clientNote        String?
  housePictures     String[]    @default([])
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  user              User        @relation(fields: [userId], references: [id])
  cleaner           Cleaner?    @relation(fields: [cleanerId], references: [id])
  service           Service?    @relation(fields: [serviceId], references: [id])
  houseConfig       HouseConfig? @relation(fields: [houseConfigId], references: [id])
  category          Category?   @relation(fields: [categoryId], references: [id])
  categoryService   CategoryService? @relation(fields: [categoryServiceId], references: [id])
  promo             Promo?      @relation(fields: [promoId], references: [id])
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AppSetting {
  key   String @id
  value String
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  nameAr      String   @default("")
  nameFr      String   @default("")
  description String   @default("")
  color       String   @default("slate")
  
  services    Service[]
  categories  Category[]
  
  createdAt   DateTime @default(now())
}
