generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url moved to prisma.config.ts
}

enum Role {
  ADMIN
  CUSTOMER
  CLEANER
}

enum OrderStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductOrigin {
  NONE
  LOCAL
  IMPORTED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String    @unique
  passwordHash  String
  fullName      String
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  
  orders        Order[]
}

model Cleaner {
  id            String    @id @default(uuid())
  fullName      String
  phone         String    @unique
  bio           String?
  isActive      Boolean   @default(true)
  rating        Float     @default(0)
  skills        String[]  @default([])
  createdAt     DateTime  @default(now())
  
  orders        Order[]
}

model Service {
  id                    String    @id @default(uuid())
  name                  String
  description           String
  picture               String
  extraWorkerPrice      Float
  durationHours         Int
  
  materialPrice         Float
  materialsMandatory    Boolean
  
  localProductPrice     Float
  importedProductPrice  Float
  productsMandatory     Boolean
  
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  
  houseConfigs          HouseConfig[]
  orders                Order[]
}

model HouseConfig {
  id            String    @id @default(uuid())
  serviceId     String
  type          String    // e.g., f2, f3, f4
  workers       Int
  basePrice     Float

  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orders        Order[]
}

model Promo {
  id                String    @id @default(uuid())
  code              String    @unique
  discountPercent   Float
  validFrom         DateTime
  validUntil        DateTime
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  
  orders            Order[]
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  cleanerId         String?
  serviceId         String
  houseConfigId     String
  promoId           String?
  
  extraWorkers      Int         @default(0)
  useMaterials      Boolean     @default(false)
  productOrigin     ProductOrigin @default(NONE)

  status            OrderStatus @default(PENDING)
  totalPrice        Float
  scheduledDate     DateTime
  address           String
  latitude          Float?
  longitude         Float?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  user              User        @relation(fields: [userId], references: [id])
  cleaner           Cleaner?    @relation(fields: [cleanerId], references: [id])
  service           Service     @relation(fields: [serviceId], references: [id])
  houseConfig       HouseConfig @relation(fields: [houseConfigId], references: [id])
  promo             Promo?      @relation(fields: [promoId], references: [id])
}
