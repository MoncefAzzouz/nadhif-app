generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
  // url moved to prisma.config.ts
}

enum Role {
  ADMIN
  CUSTOMER
  CLEANER
}

enum OrderStatus {
  PENDING
  CALLED_NOT_PAID
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductOrigin {
  NONE
  LOCAL
  IMPORTED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String    @unique
  passwordHash  String
  fullName      String
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())

  // Loyalty points balance. Never written directly: always adjusted together
  // with a PointTransaction row so the history explains every movement.
  points        Int       @default(0)

  orders        Order[]
  deviceTokens  DeviceToken[]
  subscriptions Subscription[]
  pointTransactions PointTransaction[]
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   // "android" | "ios"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cleaner {
  id            String    @id @default(uuid())
  fullName      String
  phone         String    @unique
  bio           String?
  isActive      Boolean   @default(true)
  rating        Float     @default(0)
  skills        String[]  @default([])
  createdAt     DateTime  @default(now())
  
  orders                Order[]
  subscriptionSessions  SubscriptionSession[]
}

model Service {
  id                    String    @id @default(uuid())
  name                  String
  nameAr                String    @default("")
  nameFr                String    @default("")
  description           String
  descriptionAr         String    @default("")
  descriptionFr         String    @default("")
  picture               String
  extraWorkerPrice      Float
  rapidExtraWorkerPrice Float     @default(0)
  durationHours         Int

  materialPrice         Float
  materialsMandatory    Boolean

  localProductPrice     Float
  importedProductPrice  Float
  productsMandatory     Boolean

  // ─── Point store ────────────────────────────────────────────────────────────
  // When enabled, this service appears in the app's point store and every priced
  // step below is charged in points instead of dinars.
  pointStoreEnabled          Boolean @default(false)
  extraWorkerPointCost       Int     @default(0)
  rapidExtraWorkerPointCost  Int     @default(0)
  materialPointCost          Int     @default(0)
  localProductPointCost      Int     @default(0)
  importedProductPointCost   Int     @default(0)

  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())

  // Mobile details page content (objective/includes/duration/additional + ar/fr)
  details               Json?

  houseConfigs          HouseConfig[]
  orders                Order[]
  skills                Skill[]
}

model HouseConfig {
  id            String    @id @default(uuid())
  serviceId     String
  type          String    // e.g., f2, f3, f4
  typeAr        String    @default("")
  typeFr        String    @default("")
  workers       Int
  basePrice     Float
  rapidBasePrice Float   @default(0)
  durationHours Int       @default(3)

  // Point price of this house type. 0 means it cannot be bought with points,
  // even when the parent service is in the point store.
  pointCost      Int      @default(0)
  rapidPointCost Int      @default(0)

  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  orders        Order[]
}

model Category {
  id                    String              @id @default(uuid())
  name                  String
  nameAr                String              @default("")
  nameFr                String              @default("")
  description           String
  descriptionAr         String              @default("")
  descriptionFr         String              @default("")
  picture               String
  
  materialPrice         Float               @default(0)
  materialsMandatory    Boolean             @default(false)
  
  localProductPrice     Float               @default(0)
  importedProductPrice  Float               @default(0)
  productsMandatory     Boolean             @default(false)

  // ─── Point store ────────────────────────────────────────────────────────────
  pointStoreEnabled        Boolean          @default(false)
  materialPointCost        Int              @default(0)
  localProductPointCost    Int              @default(0)
  importedProductPointCost Int              @default(0)

  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())

  // Mobile details page content (objective/includes/duration/additional + ar/fr)
  details               Json?

  categoryServices      CategoryService[]
  orders                Order[]
  skills                Skill[]
}

model CategoryService {
  id            String    @id @default(uuid())
  categoryId    String
  name          String
  nameAr        String    @default("")
  nameFr        String    @default("")
  workers       Int
  basePrice     Float
  rapidBasePrice Float   @default(0)
  durationHours Int       @default(3)

  // Point price of this option. 0 means it cannot be bought with points.
  pointCost      Int      @default(0)
  rapidPointCost Int      @default(0)

  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orders        Order[]
}

model Promo {
  id                String    @id @default(uuid())
  code              String    @unique
  discountPercent   Float
  validFrom         DateTime
  validUntil        DateTime
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  
  orders            Order[]
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  cleanerId         String?
  serviceId         String?
  houseConfigId     String?
  categoryId        String?
  categoryServiceId String?
  promoId           String?
  
  extraWorkers      Int         @default(0)
  useMaterials      Boolean     @default(false)
  productOrigin     ProductOrigin @default(NONE)

  status            OrderStatus @default(PENDING)
  totalPrice        Float
  scheduledDate     DateTime
  address           String
  latitude          Float?
  longitude         Float?
  
  isRapid           Boolean     @default(false)
  sizeM2            Float?
  clientNote        String?
  housePictures     String[]    @default([])

  // ─── Loyalty points ─────────────────────────────────────────────────────────
  // Set when the order was bought from the point store instead of paid in DZD.
  // The admin UI shows `pointsSpent` in place of `totalPrice` for these orders.
  paidWithPoints    Boolean     @default(false)
  pointsSpent       Int         @default(0)
  // Points granted to the customer when the admin marked the order COMPLETED.
  // Non-zero means the award already happened — it can never be granted twice.
  pointsAwarded     Int         @default(0)
  // Set once the points of a cancelled point-paid order have been given back.
  pointsRefunded    Boolean     @default(false)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id])
  cleaner           Cleaner?    @relation(fields: [cleanerId], references: [id])
  service           Service?    @relation(fields: [serviceId], references: [id])
  houseConfig       HouseConfig? @relation(fields: [houseConfigId], references: [id])
  category          Category?   @relation(fields: [categoryId], references: [id])
  categoryService   CategoryService? @relation(fields: [categoryServiceId], references: [id])
  promo             Promo?      @relation(fields: [promoId], references: [id])
  pointTransactions PointTransaction[]

  @@index([userId])
}

// ─── LOYALTY POINTS ───────────────────────────────────────────────────────────

enum PointTransactionType {
  EARNED     // granted by an admin when an order was completed
  SPENT      // redeemed against a point store item
  REFUNDED   // given back because a point-paid order was cancelled
  ADJUSTED   // manual correction by an admin
}

// Immutable ledger: one row per point movement, newest first in the UI.
model PointTransaction {
  id           String               @id @default(uuid())
  userId       String
  // Signed: positive credits the customer, negative debits them.
  amount       Int
  // Customer balance right after this movement, so the history reads correctly
  // even if an older row is ever corrected.
  balanceAfter Int
  type         PointTransactionType
  // Human-readable label, e.g. the service bought or why an admin adjusted.
  reason       String               @default("")
  orderId      String?
  // Admin who triggered it (null for customer-initiated purchases).
  adminId      String?
  createdAt    DateTime             @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?          @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AppSetting {
  key   String @id
  value String
}

model Slide {
  id          String   @id @default(uuid())
  title       String   @default("")
  description String   @default("")
  imageUrl    String   // base64 data URI or external URL
  actionRoute String   @default("")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  nameAr      String   @default("")
  nameFr      String   @default("")
  description String   @default("")
  color       String   @default("slate")
  
  services    Service[]
  categories  Category[]
  subscriptionServiceTiers SubscriptionServiceTier[]
  
  createdAt   DateTime @default(now())
}

// ─── SUBSCRIPTION SYSTEM ──────────────────────────────────────────────────────

enum SubscriptionStatus {
  PENDING
  DAYS_PROPOSED
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

// Admin-manageable property types (House, Villa, Apartment, Office, etc.)
model SubscriptionPropertyType {
  id        String   @id @default(uuid())
  name      String   @unique
  nameAr    String   @default("")
  nameFr    String   @default("")
  picture   String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  subscriptions Subscription[]
}

// Admin-manageable service tiers (Grand, Semi-Grand, Simple, etc.)
model SubscriptionServiceTier {
  id            String   @id @default(uuid())
  name          String   @unique
  nameAr        String   @default("")
  nameFr        String   @default("")
  description   String   @default("")
  durationHours Int      @default(3)
  workers       Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]
  skills        Skill[]
}

model Subscription {
  id               String             @id @default(uuid())
  
  // Client info
  userId           String?
  fullName         String
  phone            String
  
  // Property details
  propertyTypeId   String
  surfaceM2        Float
  roomsToClean     Int                // Number of rooms the client wants cleaned
  pictures         String[]           @default([])
  address          String             @default("")
  latitude         Float?
  longitude        Float?
  
  // Service selection
  serviceTierId    String
  daysPerWeek      Int                // e.g. 2, 3
  
  // Admin-set fields
  monthlyPrice     Float?             // Admin sets the price manually
  amountPaid       Float              @default(0) // Running total of what client has paid
  adminNote        String?            // Internal admin notes
  
  // Status & lifecycle
  status           SubscriptionStatus @default(PENDING)
  
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  // Relations
  user             User?                    @relation(fields: [userId], references: [id])
  propertyType     SubscriptionPropertyType @relation(fields: [propertyTypeId], references: [id])
  serviceTier      SubscriptionServiceTier  @relation(fields: [serviceTierId], references: [id])
  sessions         SubscriptionSession[]
  payments         SubscriptionPayment[]
  
  @@index([userId])
  @@index([status])
}

model SubscriptionSession {
  id               String    @id @default(uuid())
  subscriptionId   String
  
  scheduledDate    DateTime           // The specific day+time
  durationHours    Int       @default(3)
  cleanerId        String?            // Assigned cleaner (availability-checked)
  
  status           String    @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  
  createdAt        DateTime  @default(now())
  
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  cleaner          Cleaner?     @relation(fields: [cleanerId], references: [id])
  
  @@index([subscriptionId])
  @@index([cleanerId])
  @@index([scheduledDate])
}

model SubscriptionPayment {
  id               String    @id @default(uuid())
  subscriptionId   String
  
  amount           Float
  note             String?            // e.g. "Paid cash", "Partial payment"
  
  createdAt        DateTime  @default(now())
  
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  @@index([subscriptionId])
}

model AdminAlert {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   // "ORDER_CREATED" | "SUBSCRIPTION_CREATED" | "STATUS_CHANGED"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

